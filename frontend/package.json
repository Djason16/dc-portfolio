{
  "name": "djason-chery-nuxt-fullstack",
  "private": true,
  "description": "Nuxt 4 fullstack application with Nitro for djason-chery.dev — integrated back and front",
  "type": "module",
  "scripts": {
    "predev": "node scripts/icons.mjs && node scripts/fonts.mjs && node scripts/mediapipe.mjs",
    "dev": "nuxt dev",
    "prebuild": "node scripts/icons.mjs && node scripts/fonts.mjs && node scripts/mediapipe.mjs",
    "build": "nuxt build --dotenv .env.production",
    "prebuild:qualif": "node scripts/icons.mjs && node scripts/fonts.mjs && node scripts/mediapipe.mjs",
    "build:qualif": "node scripts/qualif.mjs build",
    "start": "node --env-file=.env.production .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "typecheck": "nuxt typecheck",
    "test:cities": "node scripts/cities-similarity.mjs",
    "test:tools": "node scripts/tools-catalog-test.mjs",
    "check:texts": "node scripts/check-texts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@pinia/nuxt": "^1.0.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "jspdf": "^4.2.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "nuxt": "^4.4.8",
    "pdf-lib": "^1.17.1",
    "pinia": "^4.1.0",
    "stripe": "^22.2.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.2",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
